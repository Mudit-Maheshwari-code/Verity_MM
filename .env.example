# Verity — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────
# DIFFBOT (Primary — data-fetching layer for all product pages)
# Sign up at: https://www.diffbot.com
# Find your token at: https://app.diffbot.com (Account / Dashboard)
# Docs:
#   - Account: https://www.diffbot.com/docs/account
#   - Authentication: https://www.diffbot.com/docs/authentication
#   - Products: https://www.diffbot.com/docs/products-overview
#
# Diffbot automatically renders JavaScript, bypasses bot blocks,
# extracts product specifications, and structures reviews/discussions.
# ─────────────────────────────────────────────────────────────
DIFFBOT_TOKEN=

# ─────────────────────────────────────────────────────────────
# Server config
# ─────────────────────────────────────────────────────────────
PORT=3001
CACHE_TTL_MINUTES=60

# ─────────────────────────────────────────────────────────────
# Note: If DIFFBOT_TOKEN is not set, the app seamlessly falls back
# to local Playwright headless scraping for e-commerce URLs, or
# curated demo mock review datasets for keyword searches.
# ─────────────────────────────────────────────────────────────
